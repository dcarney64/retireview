# ============================================================
# ProjectName environment
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Server ---
# Port the backend API listens on
PORT=8004
# 'production' or 'development' (development returns error stacks in responses)
NODE_ENV=production
# Bind address: 127.0.0.1 for local dev, 0.0.0.0 in Docker (compose sets this)
HOST=127.0.0.1

# --- HTTPS (optional) ---
# Keep false for localhost; true + a real cert (e.g. Let's Encrypt) on a server
USE_HTTPS=false
# Port for the HTTPS listener when USE_HTTPS=true
HTTPS_PORT=8443
# Paths to the TLS key/cert (required when USE_HTTPS=true)
SSL_KEY_PATH=/path/to/key.pem
SSL_CERT_PATH=/path/to/cert.pem

# --- PostgreSQL ---
# Hostname of the database ('db' inside docker compose, 'localhost' for local dev)
DB_HOST=localhost
# Database port
DB_PORT=5432
# Database name
DB_NAME=projectname_db
# Database user
DB_USER=projectname
# Database password
DB_PASSWORD=changeme

# --- JWT ---
# Access-token signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
# Refresh-token signing secret (use a DIFFERENT value than JWT_SECRET)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
# Access token lifetime
JWT_ACCESS_EXPIRES=15m
# Refresh token lifetime
JWT_REFRESH_EXPIRES=7d

# --- Admin bootstrap (first run only) ---
# Seed admin account, created automatically when the users table is empty.
# Log in with these credentials, then change the password immediately
# (Settings → Change Password) or delete these lines after first boot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# --- Encryption ---
# AES-256 key for secrets stored in the DB (e.g. TOTP secrets) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=your_32_byte_hex_key_here

# --- Passwords ---
# Server-side pepper mixed into password hashes — generate with: openssl rand -base64 32
# CRITICAL: back this up — losing it locks out all users
PASSWORD_PEPPER=your_generated_value_here
# Minimum zxcvbn score (0-4) required for new passwords
MIN_PASSWORD_SCORE=3
# Minimum password length
MIN_PASSWORD_LENGTH=12

# --- 2FA ---
# Master switch for two-factor auth (email OTP / TOTP)
TWO_FA_ENABLED=true
# Pepper for hashing email OTP codes — generate with: openssl rand -base64 24
OTP_PEPPER=generate_random_32_char_string_here
# Log OTP codes to the console instead of emailing them (dev only!)
DEV_MODE_LOG_OTP=false

# --- Email (OTP delivery + security alerts) ---
# SMTP relay host — for Gmail use an App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
# SMTP port (587 = STARTTLS)
SMTP_PORT=587
# SMTP username / login
SMTP_USER=your_email@example.com
# SMTP password or app password
SMTP_PASS=your_smtp_password
# From header on outgoing mail
SMTP_FROM=ProjectName <your_email@example.com>

# --- Security ---
# Honor x-forwarded-for only when behind a trusted reverse proxy
TRUST_PROXY=false
# Failed logins from one IP before it is auto-blocked
MAX_LOGIN_ATTEMPTS=5
# Minutes an auto-block lasts
AUTO_BLOCK_DURATION_MINUTES=60
# Days of login history kept by the nightly cleanup job
LOGIN_HISTORY_RETENTION_DAYS=90
# "Impossible travel" alert thresholds: distance + time between logins
IMPOSSIBLE_TRAVEL_DISTANCE_KM=500
IMPOSSIBLE_TRAVEL_HOURS=2

# --- Timeouts (milliseconds) ---
# Default budget for outbound API requests
API_REQUEST_TIMEOUT_MS=30000

# ADD YOUR APP VARIABLES BELOW THIS LINE
